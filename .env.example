TELEGRAM_BOT_TOKEN=123456:replace_me
TELEGRAM_ADMIN_CHAT_ID=123456789

# worker
CHECK_INTERVAL_SECONDS=120
DATABASE_PATH=./data/tour-deals.sqlite
PROVIDER=tourvisor-public
LOG_LEVEL=info

# Tourvisor public search flow captured from tourvisor.ru/search.php.
TOURVISOR_MODSEARCH_URL=https://tourvisor.ru/xml/modsearch.php
TOURVISOR_MODRESULT_URL=https://search3.tourvisor.ru/modresult.php

# Tourvisor official/partner API mode, if you get paid API access later.
TOURVISOR_API_BASE_URL=
TOURVISOR_API_KEY=

# Browser fallback mode. Use only if it is allowed for your use case and rate limits are gentle.
TOURVISOR_SEARCH_URL_TEMPLATE=https://tourvisor.ru/search.php

# Currency conversion. RUB is base. Update manually or wire a paid FX API later.
USD_TO_RUB=90
EUR_TO_RUB=98

# Search preset JSON. Keep it on one line in .env.
# For public Tourvisor flow, IDs are required: departureId/countryId/regionIds.
SEARCH_PRESETS_JSON=[{"id":"turkey-ai-june","enabled":true,"title":"Turkey AI June","departureCity":"Moscow","departureId":57,"countries":["Turkey"],"countryId":16,"resorts":[],"regionIds":[87],"dateFrom":"2026-06-15","dateTo":"2026-07-15","nightsFrom":7,"nightsTo":10,"adults":2,"children":0,"meal":"AI","hotelStarsMin":5,"budget":{"amount":120000,"currency":"RUB"},"discountPercent":20}]
